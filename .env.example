# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENWEATHER_KEY: Optional OpenWeatherMap API key for weather and forecast lookups.
# Falls back to Open-Meteo when omitted.
OPENWEATHER_KEY="MY_OPENWEATHER_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# === PERSISTÊNCIA DE SESSÕES (Opcional para produção Cloud Run) ===
# Caso nenhuma opção externa seja definida, o ELI utiliza armazenamento em arquivo
# no diretório ELI_DATA_DIR (padrão ./.eli-data — útil localmente ou com Cloud Run Volume Mount).
# Para persistência externa recomendada no Cloud Run, configure Upstash Redis REST ou Firestore:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
FIRESTORE_PROJECT_ID=
ELI_DATA_DIR=

